// Venture Studio OS — Prisma schema (Phase 01 Foundation)
// Normative source: 04-architecture/DATA_MODEL.md
// NOTE: SQLite does not support native enums, so enum-like fields are stored as
// String and validated by Zod at the service layer (see src/lib/validation.ts).
// MVP uses UTC timestamps everywhere (DAT model rule).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id               String    @id @default(uuid())
  name             String // 1..150
  summary          String? // 0..500
  status           String    @default("DRAFT") // ProjectStatus
  health           String    @default("HEALTHY") // ProjectHealth (derived)
  templateId       String? // built-in id or custom ProjectTemplate id
  templateVersion  String?
  currentStageId   String?
  ownerName        String // 1..120
  startedAt        DateTime?
  targetDate       DateTime? // stored as date; compared by date only at service layer
  progressPercent  Int       @default(0) // 0..100 (derived)
  archivedAt       DateTime?
  preArchiveStatus String?
  createdAt        DateTime  @default(now()) @map("createdAt")
  updatedAt        DateTime  @updatedAt @map("updatedAt")

  brainEntries         ProjectBrainEntry[]
  stages               ProjectStage[]
  deliverables         Deliverable[]
  workPackets          WorkPacket[]
  reviews              Review[]
  decisions            DecisionRecord[]
  risks                RiskRecord[]
  versions             VersionRecord[]
  activities           ActivityRecord[]
  intents              ProjectIntent[]
  benchmarks           BenchmarkBrief[]
  qualityProfiles      QualityProfile[]
  gateResults          QualityGateResult[]
  learningRecords      LearningRecord[]
  evidence             Evidence[]
  attentionEvents      AttentionEvent[]
  acceptanceCriterions AcceptanceCriterion[]
  attachments          Attachment[]
  requirements         Requirement[]
  agentActivities      AgentActivity[]
  queueItems           ExecutionQueueItem[]
  directionRequests    DirectionRequest[]
  exceptions           Exception[]
  projectTemplates     ProjectTemplate[] // custom templates authored for this project (TPL-003)

  @@index([status])
  @@index([archivedAt])
}

model ProjectBrainEntry {
  id        String   @id @default(uuid())
  projectId String
  section   String // ProjectBrainSection enum
  title     String // 1..150
  content   String // markdown (sanitized before render)
  order     Int // >=0, unique within project+section
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, section, order])
  @@index([projectId])
}

model ProjectStage {
  id              String   @id @default(uuid())
  projectId       String
  templateStageId String?
  name            String // 1..100
  order           Int // >=0 unique within project
  status          String   @default("NOT_STARTED") // StageStatus
  entryCriteria   String   @default("[]") // JSON array
  exitCriteria    String   @default("[]") // JSON array
  createdAt       DateTime @default(now()) @map("createdAt")
  updatedAt       DateTime @updatedAt @map("updatedAt")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
  @@index([projectId])
}

model Deliverable {
  id           String    @id @default(uuid())
  projectId    String
  parentId     String?
  stageId      String?
  title        String // 1..180
  description  String? // markdown
  type         String // 1..80
  status       String    @default("PLANNED") // DeliverableStatus
  priority     String    @default("MEDIUM") // Priority
  ownerAgentId String?
  dueDate      DateTime?
  order        Int // >=0 unique among siblings
  weight       Float     @default(1) // 0..100
  createdAt    DateTime  @default(now()) @map("createdAt")
  updatedAt    DateTime  @updatedAt @map("updatedAt")
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  children           Deliverable[]           @relation("DeliverableHierarchy")
  parent             Deliverable?            @relation("DeliverableHierarchy", fields: [parentId], references: [id])
  requirementLinks   RequirementLink[]
  dependencies       DeliverableDependency[] @relation("DependsOn")
  dependedOnBy       DeliverableDependency[] @relation("DependedBy")
  acceptanceCriteria AcceptanceCriterion[]
  workPackets        WorkPacket[]

  @@unique([parentId, order])
  @@index([projectId])
  @@index([parentId])
}

model DeliverableDependency {
  id                     String      @id @default(uuid())
  deliverableId          String
  dependsOnDeliverableId String
  deliverable            Deliverable @relation("DependsOn", fields: [deliverableId], references: [id], onDelete: Cascade)
  dependsOn              Deliverable @relation("DependedBy", fields: [dependsOnDeliverableId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, dependsOnDeliverableId])
  @@index([deliverableId])
}

model AcceptanceCriterion {
  id                 String       @id @default(uuid())
  projectId          String
  deliverableId      String?
  workPacketId       String?
  statement          String // 1..500
  status             String       @default("NOT_VERIFIED") // CriterionStatus
  verificationMethod String       @default("MANUAL_CHECK") // VerificationMethod
  evidenceRequired   Boolean      @default(true)
  createdAt          DateTime     @default(now()) @map("createdAt")
  updatedAt          DateTime     @updatedAt @map("updatedAt")
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable        Deliverable? @relation(fields: [deliverableId], references: [id])
  workPacket         WorkPacket?  @relation(fields: [workPacketId], references: [id])
  evidence           Evidence[]

  @@index([projectId])
  @@index([deliverableId])
  @@index([workPacketId])
}

model WorkPacket {
  id                 String                @id @default(uuid())
  projectId          String
  deliverableId      String?
  title              String // 1..180
  objective          String // markdown
  scope              String // markdown
  exclusions         String // markdown
  inputs             String                @default("[]") // JSON array
  expectedOutputs    String                @default("[]") // JSON array (>=1)
  status             String                @default("DRAFT") // WorkPacketStatus
  assigneeAgentId    String?
  priority           String                @default("MEDIUM") // Priority
  dueDate            DateTime?
  submittedAt        DateTime?
  approvedAt         DateTime?
  versionNumber      Int                   @default(1) // >=1
  versionCreatedAt   DateTime?
  // AGT-002 execution queue fields
  queueOrder         Int                   @default(0)
  queueStatus        String?               // QueueStatus | null when not queued
  createdAt          DateTime              @default(now()) @map("createdAt")
  updatedAt          DateTime              @updatedAt @map("updatedAt")
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable        Deliverable?          @relation(fields: [deliverableId], references: [id])
  acceptanceCriteria AcceptanceCriterion[]
  evidence           Evidence[]
  attachments        Attachment[]
  reviews            Review[]
  queueItem          ExecutionQueueItem?   @relation("QueueItemWorkPacket")
  requirementLinks   RequirementLink[]

  @@index([projectId])
  @@index([deliverableId])
}

model Evidence {
  id                     String               @id @default(uuid())
  projectId              String
  workPacketId           String?
  acceptanceCriterionId  String?
  type                   String // EvidenceType
  title                  String // 1..150
  location               String? // file path/URL where relevant
  checksum               String?
  immutableAfterApproval Boolean              @default(true)
  createdAt              DateTime             @default(now()) @map("createdAt")
  updatedAt              DateTime             @updatedAt @map("updatedAt")
  project                Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPacket             WorkPacket?          @relation(fields: [workPacketId], references: [id])
  acceptanceCriterion    AcceptanceCriterion? @relation(fields: [acceptanceCriterionId], references: [id])
  attachments            Attachment[]

  @@index([projectId])
  @@index([workPacketId])
}

model Review {
  id               String          @id @default(uuid())
  workPacketId     String
  reviewerName     String // 1..120
  status           String          @default("PENDING") // ReviewStatus
  summary          String? // markdown
  submittedVersion Int
  decidedAt        DateTime?
  createdAt        DateTime        @default(now()) @map("createdAt")
  updatedAt        DateTime        @updatedAt @map("updatedAt")
  workPacket       WorkPacket      @relation(fields: [workPacketId], references: [id], onDelete: Cascade)
  comments         ReviewComment[]
  project          Project?        @relation(fields: [projectId], references: [id])
  projectId        String?

  @@index([workPacketId])
}

model ReviewComment {
  id          String   @id @default(uuid())
  reviewId    String
  authorName  String
  body        String
  criterionId String?
  createdAt   DateTime @default(now()) @map("createdAt")
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model DecisionRecord {
  id                     String   @id @default(uuid())
  projectId              String?
  decisionId             String // unique human-readable
  title                  String // 1..180
  context                String // markdown
  options                String // JSON array
  selectedOption         String
  rationale              String // markdown
  affectedRequirementIds String   @default("[]") // JSON array
  decidedBy              String
  decidedAt              DateTime
  createdAt              DateTime @default(now()) @map("createdAt")
  updatedAt              DateTime @updatedAt @map("updatedAt")
  project                Project? @relation(fields: [projectId], references: [id])

  @@unique([decisionId])
  @@index([projectId])
}

model RiskRecord {
  id           String    @id @default(uuid())
  projectId    String
  title        String
  description  String?
  impact       String // RiskImpact
  likelihood   String // RiskLikelihood
  status       String    @default("OPEN") // RiskStatus
  mitigation   String?
  ownerAgentId String?
  targetDate   DateTime?
  reviewDate   DateTime?
  createdAt    DateTime  @default(now()) @map("createdAt")
  updatedAt    DateTime  @updatedAt @map("updatedAt")
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model VersionRecord {
  id              String    @id @default(uuid())
  projectId       String
  versionLabel    String
  versionType     String // VersionType
  sourceReference String?
  changeSummary   String?
  status          String
  createdBy       String
  approvedAt      DateTime?
  releasedAt      DateTime?
  createdAt       DateTime  @default(now()) @map("createdAt")
  updatedAt       DateTime  @updatedAt @map("updatedAt")
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Agent {
  id            String   @id @default(uuid())
  name          String
  kind          String // AgentKind: HUMAN | AI
  provider      String?
  model         String?
  capabilities  String   @default("[]") // JSON
  autonomyLevel String   @default("MANUAL") // AutonomyLevel
  status        String   @default("IDLE") // AgentStatus
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")
}

model ActivityRecord {
  id         String   @id @default(uuid())
  actor      String
  action     String
  entityType String
  entityId   String
  projectId  String?
  summary    String
  metadata   String   @default("{}") // JSON
  createdAt  DateTime @default(now()) @map("createdAt")
  project    Project? @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([entityType, entityId])
}

model ProjectIntent {
  id               String    @id @default(uuid())
  projectId        String
  problem          String
  audience         String
  desiredOutcome   String
  constraints      String
  nonGoals         String
  successMeasures  String    @default("[]") // JSON
  ownerPriorities  String    @default("[]") // JSON
  commercialTarget String?
  status           String    @default("DRAFT") // IntentStatus
  approvedAt       DateTime?
  supersededById   String?
  createdAt        DateTime  @default(now()) @map("createdAt")
  updatedAt        DateTime  @updatedAt @map("updatedAt")
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BenchmarkBrief {
  id                   String    @id @default(uuid())
  projectId            String
  purpose              String
  references           String    @default("[]") // JSON
  dimensions           String    @default("[]") // JSON
  marketBaseline       String?
  targetSummary        String?
  differentiators      String    @default("[]") // JSON
  intentionalOmissions String    @default("[]") // JSON
  evidenceDate         DateTime?
  status               String    @default("DRAFT") // BenchmarkStatus
  createdAt            DateTime  @default(now()) @map("createdAt")
  updatedAt            DateTime  @updatedAt @map("updatedAt")
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model QualityProfile {
  id                  String   @id @default(uuid())
  projectId           String
  version             String   @default("1.0.0")
  isLatest            Boolean  @default(true)
  name                String
  projectTypeId       String
  dimensions          String   @default("[]") // JSON
  mandatoryDimensions String   @default("[]") // JSON
  targetLevels        String   @default("[]") // JSON (QualityLevel)
  status              String   @default("DRAFT") // ProfileStatus
  createdAt           DateTime @default(now()) @map("createdAt")
  updatedAt           DateTime @updatedAt @map("updatedAt")
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId])
  @@index([isLatest])
}

model QualityGateResult {
  id               String   @id @default(uuid())
  projectId        String
  level            String // GateLevel
  entityId         String
  outcome          String // GateOutcome
  criterionResults String   @default("[]") // JSON
  evidenceIds      String   @default("[]") // JSON
  riskDecisionId   String?
  evaluatedBy      String
  evaluatedAt      DateTime @default(now())
  createdAt        DateTime @default(now()) @map("createdAt")
  project          Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model LearningRecord {
  id                 String   @id @default(uuid())
  projectId          String
  sourceType         String // LearningSource
  summary            String
  evidenceIds        String   @default("[]") // JSON
  impact             String?
  status             String   @default("NEW") // LearningStatus
  convertedReference String?
  createdAt          DateTime @default(now()) @map("createdAt")
  updatedAt          DateTime @updatedAt @map("updatedAt")
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updatedAt")
  updatedBy String?
}

model AttentionEvent {
  id              String    @id @default(uuid())
  projectId       String
  type            String // AttentionEventType
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  relatedEntityId String?
  notes           String?
  createdAt       DateTime  @default(now()) @map("createdAt")
  project         Project   @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

// ATT-001/002 — Evidence attachment: files, links, notes, test results, artifacts.
// Filename is sanitized on write; checksum + size retained for file artifacts.
model Attachment {
  id            String   @id @default(uuid())
  projectId     String
  workPacketId  String?
  evidenceId    String?
  type          String // EvidenceType
  title         String // 1..150
  // sanitized storage filename (or external URL for LINK)
  fileName      String?
  originalName  String?
  location      String? // file path or URL
  checksum      String? // sha256 hex (files in approved work)
  sizeBytes     Int?
  notes         String?
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPacket     WorkPacket? @relation(fields: [workPacketId], references: [id], onDelete: Cascade)
  evidence      Evidence?  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workPacketId])
  @@index([evidenceId])
}

// DSG-002 — Requirement registry + mapping to deliverables/work packets.
model Requirement {
  id            String   @id @default(uuid())
  projectId     String?
  code          String // e.g. WPK-001 (unique within product, not per project)
  title         String // 1..180
  description   String
  phase         Int?
  status        String   @default("ACTIVE") // RequirementStatus
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")
  project       Project? @relation(fields: [projectId], references: [id])
  links         RequirementLink[]

  @@unique([code])
  @@index([projectId])
}

// DSG-002 — Explicit requirement -> deliverable / work packet / dependency mapping.
model RequirementLink {
  id                 String   @id @default(uuid())
  requirementId      String
  projectId          String?
  targetType         String   @default("DELIVERABLE") // LinkTargetType: DELIVERABLE | WORK_PACKET | PROJECT
  deliverableId      String?
  workPacketId       String?
  isExclusion        Boolean  @default(false)
  dependencyDetail   String? // markdown: why/how this work satisfies the requirement
  exclusions         String? // markdown: explicit scope exclusions
  evidenceExpectation String? // markdown: what evidence proves completion
  createdAt          DateTime @default(now()) @map("createdAt")
  updatedAt          DateTime @updatedAt @map("updatedAt")
  requirement        Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  deliverable        Deliverable? @relation(fields: [deliverableId], references: [id])
  workPacket         WorkPacket?  @relation(fields: [workPacketId], references: [id])

  @@index([requirementId])
  @@index([deliverableId])
  @@index([workPacketId])
  @@index([projectId])
}

// AGT-003 — Append-only agent activity + outcomes.
model AgentActivity {
  id            String   @id @default(uuid())
  projectId     String?
  agentId       String? // references Agent.id (not enforced FK; agents may be external)
  agentName     String
  action        String
  entityType    String?
  entityId      String?
  outcome       String // ActivityOutcome: SUCCESS | FAILURE | BLOCKED | PARTIAL
  summary       String
  startedAt     DateTime?
  endedAt       DateTime?
  durationMs    Int?
  metadata      String   @default("{}") // JSON
  createdAt     DateTime @default(now()) @map("createdAt")
  project       Project? @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([agentId])
  @@index([entityType, entityId])
}

// AGT-002 — Ordered execution queue with dependencies and evidence.
model ExecutionQueueItem {
  id             String   @id @default(uuid())
  workPacketId   String   @unique
  projectId      String
  order          Int      @default(0)
  queueStatus    String   @default("READY") // QueueStatus
  dependsOnId    String?  // depends on another queue item
  blockedReason  String?
  evidenceNote   String?
  linkedEvidence  String   @default("[]") // JSON array of evidence record ids
  createdAt      DateTime @default(now()) @map("createdAt")
  updatedAt      DateTime @updatedAt @map("updatedAt")
  workPacket     WorkPacket @relation("QueueItemWorkPacket", fields: [workPacketId], references: [id], onDelete: Cascade)
  dependsOn      ExecutionQueueItem? @relation("QueueItemDependsOn", fields: [dependsOnId], references: [id])
  dependedOnBy   ExecutionQueueItem[] @relation("QueueItemDependsOn")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([dependsOnId])
}

// EXC-001/002/003/004 — Consequential ambiguity / direction-required escalation.
// A DirectionRequest is created when an agent hits a consequential ambiguity it
// cannot resolve within approved boundaries. It blocks the dependent work until a
// persisted owner response is recorded (decidedBy + resolution + decidedAt).
model DirectionRequest {
  id          String   @id @default(uuid())
  projectId   String
  title       String // 1..180
  question    String // markdown
  context     String? // markdown rationale
  options     String   @default("[]") // JSON array of { id, label, recommended? }
  status      String   @default("OPEN") // DirectionRequestStatus
  severity    String   @default("DIRECTION_REQUIRED") // IssueSeverity
  resolution  String? // chosen option id or free-text owner decision
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

// EXC-001 — Classify recoverable assumptions, direction-required, and critical issues.
model Exception {
  id            String   @id @default(uuid())
  projectId     String
  classification String  @default("RECOVERABLE") // IssueClassification
  title         String // 1..180
  detail        String? // markdown
  status        String   @default("OPEN") // IssueStatus
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([classification])
  @@index([status])
}

// TPL-003 — Custom project templates with versioning.
// A template is a reusable definition of stages, deliverables, gates,
// brain sections, and a default quality profile. Versions are immutable
// snapshots; a new save supersedes rather than overwrites.
model ProjectTemplate {
  id            String   @id @default(uuid())
  projectId     String? // owning project; null for global/library templates
  key           String // stable identifier within the owning scope (e.g. "my-build-v1")
  name          String // 1..150
  description   String? // markdown
  version        String // semantic-ish version label, e.g. "1.0.0"
  isLatest       Boolean  @default(true)
  projectTypeId  String // drives default Quality Profile dimensions (QLT-001)
  stages         TemplateStage[]
  deliverables   TemplateDeliverable[]
  gates          TemplateGate[]
  brainSections  TemplateBrainSection[]
  qualityProfile TemplateQualityProfile?
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key, version])
  @@index([projectId])
  @@index([key])
}

model TemplateStage {
  id            String   @id @default(uuid())
  templateId    String
  name          String // 1..120
  order         Int // >=0 unique within template
  entryCriteria String   @default("[]") // JSON array
  exitCriteria  String   @default("[]") // JSON array
  template      ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, order])
  @@index([templateId])
}

model TemplateDeliverable {
  id          String   @id @default(uuid())
  templateId  String
  parentKey   String? // references another TemplateDeliverable.key within same template
  stageKey    String? // references a TemplateStage by name for stage assignment
  key         String // stable id within template (for hierarchy + dependency resolution)
  title       String // 1..180
  description String? // markdown
  type        String // 1..80
  priority    String   @default("MEDIUM") // Priority
  order       Int // >=0 unique among siblings
  weight      Float    @default(1)
  dependsOn   String   @default("[]") // JSON array of TemplateDeliverable.key
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
}

model TemplateGate {
  id          String   @id @default(uuid())
  templateId  String
  level       String // GateLevel
  name        String // 1..150
  criteria    String   @default("[]") // JSON array of criterion statements
  order       Int // >=0 unique within template+level
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, level, order])
  @@index([templateId])
}

model TemplateBrainSection {
  id         String   @id @default(uuid())
  templateId String
  section    String // BrainSection enum
  title      String // 1..150
  content    String // markdown
  order      Int // >=0 unique within template+section
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, section, order])
  @@index([templateId])
}

// TPL-003 / QLT-001 — Default quality profile seeded when instantiating a template.
model TemplateQualityProfile {
  id                  String   @id @default(uuid())
  templateId          String   @unique
  name                String
  projectTypeId       String
  dimensions          String   @default("[]") // JSON
  mandatoryDimensions String   @default("[]") // JSON
  targetLevels        String   @default("[]") // JSON (QualityLevel)
  template            ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

