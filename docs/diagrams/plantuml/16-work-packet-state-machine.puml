@startuml
[*] --> DRAFT
DRAFT --> READY
DRAFT --> CANCELLED
READY --> IN_PROGRESS
READY --> CANCELLED
IN_PROGRESS --> SUBMITTED
SUBMITTED --> IN_REVIEW
IN_REVIEW --> APPROVED
IN_REVIEW --> REVISION_REQUESTED
IN_REVIEW --> REJECTED
REVISION_REQUESTED --> IN_PROGRESS : create next version
APPROVED --> [*]
REJECTED --> [*]
CANCELLED --> [*]
@enduml
